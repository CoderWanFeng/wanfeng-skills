skills/mograph-pro/
skills/wanfeng-digital-human-pro/

# ============================================================
# 三、打包与发布产物（均可由源码或脚本再生，不入库）
# ============================================================
# Skill 压缩包交付目录（<skill-name>.zip 与 skills/ 目录一一对应，
# 由 .build/package-workbuddy.py / package-mograph-pro.py 生成）
skills/ZIP/
# 早期打包产物遗留目录（已被 skills/ZIP/ 取代，待清理）
dist/
# SkillHub 发布笔记 + 批量发布 / 图标脚本（内部运维资料，含账号发布流程）
docs/skillhub-publish/
# 发布与打包的 staging 副本、zip-backup 备份（由 publish.py / package-*.py 生成）
.build/

# ============================================================
# 四、Python 编译缓存（可再生，禁止入库）
# ============================================================
__pycache__/
*.py[cod]

# ============================================================
# 五、系统文件（macOS Finder 元数据，任何层级）
# ============================================================
.DS_Store
