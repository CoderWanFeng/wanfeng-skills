# ============================================================
# 一、本地工作目录（未发布的草稿与工作资料）
# 规则以 / 结尾：任何层级下同名的目录及其全部内容一并排除
# ============================================================
todo/
test/
workflow/
.trae/
.qoder/

# ============================================================
# 二、私有商业产品与支付配套（源码不入公开库）
# mograph-pro 通过付费 ZIP 交付；mograph-pro-pay 仅作授权适配
# ============================================================
skills/mograph-pro/
skills/mograph-pro-pay/

# ============================================================
# 三、打包与发布产物（均可由源码或脚本再生，不入库）
# ============================================================
# 打包产物生成到 dist/ 目录，由 .build/package-*.py 脚本输出
dist/
# SkillHub 发布笔记 + 批量发布 / 图标脚本（内部运维资料，含账号发布流程）
docs/skillhub-publish/
# 研发用私有背景资料（同行项目清单等，只在本机看，不公开）
docs/research/
# 发布与打包的 staging 副本、zip-backup 备份（由 publish.py / package-*.py 生成）
.build/

# ============================================================
# 四、Python 编译缓存（可再生，禁止入库）
# ============================================================
__pycache__/
*.py[cod]
# 虚拟环境（本地依赖副本，不入库）
.venv/
venv/

# ============================================================
# 五、系统文件（macOS Finder 元数据，任何层级）
# ============================================================
.DS_Store

# ============================================================
# 六、WorkBuddy 专家（Expert）上架骨架（与 skills/ 同级；含 .codebuddy-plugin 私有配置，暂不入库）
# ============================================================
/experts/
