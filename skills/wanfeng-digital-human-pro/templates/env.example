# 复制本文件为 .env，填入真实值，然后 chmod 600 .env
# .env 优先于 shell 环境变量，会覆盖同名变量——这是有意设计，避免旧 Key 污染

# ── 后端选型（也可用命令行参数临时覆盖）─────────────────────────
# 出镜画面：credits 软件积分 / minimax 云端 H3 / compshare 自托管 H3
# DH_VIDEO_BACKEND=minimax   # 默认；init_workspace 会按你的选择写一行真实值
# 语音：minimax 克隆音色 / local 本地 Ming
# DH_VOICE_BACKEND=minimax
# MiniMax 接入方式：official 官方 API / recommended 我们推荐的平台 API
# DH_MINIMAX_ROUTE=official

# ── 路由 official：官方开放平台 ────────────────────────────────
# 获取：platform.minimax.cn -> 账户管理 -> 接口密钥（按量付费，不是 sk-cp- 订阅通道）
MINIMAX_API_KEY=REPLACE_ME
# 你克隆出来的音色 ID，字母开头，8-256 位
MINIMAX_VOICE_ID=my-clone-voice

# ── 路由 recommended：我们推荐的平台 ──────────────────────────
# 换成平台给你的接口地址（不要带结尾斜杠）与密钥
MINIMAX_RECOMMENDED_BASE_URL=
MINIMAX_RECOMMENDED_API_KEY=

# ── 语音 local：本地 Ming + mlx_audio ─────────────────────────
# 只用本机现有 Python 3.11，不安装新版本
MING_TTS_PYTHON=
MING_TTS_MODEL=
MING_TTS_REF_AUDIO=
MING_TTS_REF_TEXT=

# ── 画面 compshare：自托管 ComfyUI H3 ─────────────────────────
# digital 阶段前把实例开机，填可访问的地址；单价用于估算，以平台账单为准
COMPSHARE_BASE_URL=
COMPSHARE_HOURLY_PRICE=2.15
COMPSHARE_TIMEOUT=3600

# ── 画面 credits：软件积分 ───────────────────────────────────
# 不需要密钥。片段放 input/credits/seg_001.mp4，引擎只做对齐与拼接。

# 通常无需设置；自动定位失败时才指定工作区绝对路径
# DH_WORK_ROOT=/path/to/digital-human-work
